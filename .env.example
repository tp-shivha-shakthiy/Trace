# TRACE configuration.

# --- Database ---------------------------------------------------------------
# Async SQLAlchemy URL (psycopg3 driver).
# The docker-compose setup uses: trace / trace on the `postgres` service.
DATABASE_URL=postgresql+psycopg://trace:trace@localhost:5432/trace

# --- GitHub ----------------------------------------------------------------
# Optional. Raise the unauthenticated rate limit (60 req/hr) to 5000 req/hr.
# Create one at https://github.com/settings/tokens
# GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15

# --- Ingestion bounds --------------------------------------------------------
# Caps keep a single sync bounded and demo-friendly.
INGESTION_EVENTS_PER_PAGE=30
INGESTION_EVENTS_MAX_PAGES=3
INGESTION_REPOS_PER_PAGE=100
INGESTION_REPOS_MAX_PAGES=2
INGESTION_LANGUAGE_REPOS_LIMIT=10

# --- Worker ------------------------------------------------------------------
# Number of concurrent background ingestion workers (in-process asyncio tasks).
SYNC_WORKER_CONCURRENCY=2